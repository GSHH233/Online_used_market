SERVER_PORT=8080
# Optional: separate management port, e.g. 8081; defaults to SERVER_PORT.
MANAGEMENT_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Use a random secret and mount the same value into the Prometheus token file.
PROMETHEUS_SCRAPE_TOKEN=
AI_CHAT_MEMORY_STORE=redis
AI_CHAT_RATE_LIMIT_PER_MINUTE=10

MYSQL_URL=jdbc:mysql://localhost:3306/used_market?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
OPENAI_CHAT_MODEL=qwen-plus
OPENAI_EMBEDDING_MODEL=text-embedding-v3

JWT_SECRET=change-me-use-env-in-production-32bytes-min

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=5

ELASTICSEARCH_URIS=http://localhost:9200
MILVUS_HOST=localhost
MILVUS_PORT=19530
PROMETHEUS_BASE_URL=http://localhost:9090

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=used-market

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

MEMORY_GRAPH_PG_URL=jdbc:postgresql://localhost:5432/used_market
MEMORY_GRAPH_PG_USERNAME=postgres
MEMORY_GRAPH_PG_PASSWORD=change-me
